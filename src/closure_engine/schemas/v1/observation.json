{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ace:v1:observation",
  "type": "object",
  "properties": {
    "algorithm": {
      "const": "Ed25519"
    },
    "payload": {
      "type": "object",
      "properties": {
        "version": {
          "const": "v1"
        },
        "purpose": {
          "const": "observation"
        },
        "issuer": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:/-]{1,160}$"
        },
        "key_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:/-]{1,160}$"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "body": {
          "type": "object",
          "properties": {
            "transaction_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:/-]{1,160}$"
            },
            "attempt_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:/-]{1,160}$"
            },
            "contract_hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "artifact_hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "target_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:/-]{1,160}$"
            },
            "observation_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:/-]{1,160}$"
            },
            "check_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:/-]{1,160}$"
            },
            "evaluator_hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "policy_hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "nonce": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:/-]{1,160}$"
            },
            "phase": {
              "enum": [
                "instant",
                "window"
              ]
            },
            "observed_at": {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            "result": {
              "enum": [
                "PASS",
                "FAIL",
                "UNKNOWN",
                "NOT_COMPLETED"
              ]
            },
            "evidence_hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "tamper_detected": {
              "type": "boolean"
            }
          },
          "required": [
            "transaction_id",
            "attempt_id",
            "contract_hash",
            "artifact_hash",
            "target_id",
            "observation_id",
            "check_id",
            "evaluator_hash",
            "policy_hash",
            "nonce",
            "phase",
            "observed_at",
            "result",
            "evidence_hash",
            "tamper_detected"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "version",
        "purpose",
        "issuer",
        "key_id",
        "created_at",
        "body"
      ],
      "additionalProperties": false
    },
    "signature": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}$"
    }
  },
  "required": [
    "algorithm",
    "payload",
    "signature"
  ],
  "additionalProperties": false
}
